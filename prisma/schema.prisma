// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  authProvider String   @default("anonymous")
  email        String?  @unique
  displayName  String?
  isAnonymous  Boolean  @default(true)

  favorites     Favorite[]
  feedSessions  FeedSession[]
  telemetry     TelemetryEvent[]
}

model Game {
  id             String   @id
  title          String
  subtitle       String   @default("")
  description    String   @default("")
  creatorName    String   @default("LOOPED")
  status         String   @default("active") // draft|active|paused|deprecated
  primaryGenre   String   @default("arcade") // arcade|puzzle|learn|create|tool
  tags           String   @default("[]") // JSON array stored as string
  sessionLengthSec Int    @default(60)
  inputModes     String   @default("[]") // JSON array: tap|drag|swipe|hold|tilt
  orientation    String   @default("portrait") // portrait|landscape|auto
  contentRating  String   @default("E") // E|E10|T|M
  lanes          String   @default("[]") // JSON array: main|learn|tools|creative
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  builds     GameBuild[]
  favorites  Favorite[]
  telemetry  TelemetryEvent[]
}

model GameBuild {
  id              String   @id @default(cuid())
  gameId          String
  version         String   @default("1.0.0")
  url             String
  entry           String   @default("index.html")
  allowedOrigin   String
  featuresJson    String   @default("{}") // supports_pause/resume/audio/haptics/share_snapshot
  sandboxOverride String?
  allowOverride   String?
  integritySha256 String?
  minClientVersion String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model FeedSession {
  id         String   @id @default(cuid())
  userId     String?
  createdAt  DateTime @default(now())
  
  clientVersion String @default("")
  locale        String @default("")
  timezone      String @default("")
  platform      String @default("")
  deviceModel   String @default("")
  network       String @default("")
  appVersion    String @default("")

  user      User?            @relation(fields: [userId], references: [id])
  telemetry TelemetryEvent[]
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  sessionId String
  userId    String?
  gameId    String?
  event     String
  payload   String   @default("{}") // JSON

  session FeedSession @relation(fields: [sessionId], references: [id])
  user    User?       @relation(fields: [userId], references: [id])
  game    Game?       @relation(fields: [gameId], references: [id])
}
